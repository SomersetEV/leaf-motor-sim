BS_:

BU_: ZOMBIE LEAFSIM


BO_ 282 VCM_11A: 8 ZOMBIE
 SG_ Gear : 0|8@1+ (1,0) [0|255] "" LEAFSIM
 SG_ OnOff : 8|8@1+ (1,0) [0|255] "" LEAFSIM
 SG_ Counter : 48|2@1+ (1,0) [0|3] "" LEAFSIM
 SG_ CRC : 56|8@1+ (1,0) [0|255] "" LEAFSIM

BO_ 468 VCM_TorqueCmd_1D4: 8 ZOMBIE
 SG_ TorqueRequestRaw : 23|12@0- (1,0) [-2048|2047] "" LEAFSIM
 SG_ HVStatus : 32|4@1+ (1,0) [0|15] "" LEAFSIM
 SG_ Counter : 38|2@1+ (1,0) [0|3] "" LEAFSIM
 SG_ CRC : 56|8@1+ (1,0) [0|255] "" LEAFSIM

BO_ 474 INV_Status_1DA: 8 LEAFSIM
 SG_ Voltage : 0|8@1+ (2,0) [0|510] "V" ZOMBIE
 SG_ ReportedTorque : 18|11@0- (0.5,0) [-512|511.5] "Nm" ZOMBIE
 SG_ MotorSpeed : 39|16@0- (0.5,0) [-16384|16383.5] "rpm" ZOMBIE
 SG_ ErrorBits : 52|4@1+ (1,0) [0|15] "" ZOMBIE

BO_ 1184 GOV_Speed_4A0: 8 ZOMBIE
 SG_ GovSpeedIn : 0|16@1+ (1,0) [0|65535] "rpm" LEAFSIM
 SG_ GovSpeedErr : 16|16@1- (0.125,0) [-4096|4095.875] "rpm" LEAFSIM
 SG_ PotUser : 32|16@1- (0.01,0) [-327.68|327.67] "%" LEAFSIM
 SG_ Potnom : 48|16@1- (0.01,0) [-327.68|327.67] "%" LEAFSIM

BO_ 1185 GOV_Terms_4A1: 8 ZOMBIE
 SG_ GovInt : 0|16@1- (0.01,0) [-327.68|327.67] "%" LEAFSIM
 SG_ GovP : 16|16@1- (0.01,0) [-327.68|327.67] "%" LEAFSIM
 SG_ GovD : 32|16@1- (0.01,0) [-327.68|327.67] "%" LEAFSIM
 SG_ GovBinding : 48|1@1+ (1,0) [0|1] "" LEAFSIM
 SG_ GovOver : 49|1@1+ (1,0) [0|1] "" LEAFSIM
 SG_ GovIntReset : 50|1@1+ (1,0) [0|1] "" LEAFSIM
 SG_ GovIntFrozen : 51|1@1+ (1,0) [0|1] "" LEAFSIM
 SG_ GovIntClamped : 52|1@1+ (1,0) [0|1] "" LEAFSIM
 SG_ GovCounter : 56|8@1+ (1,0) [0|255] "" LEAFSIM

BO_ 1186 GOV_Gains_4A2: 8 ZOMBIE
 SG_ Revlim : 0|16@1+ (1,0) [0|65535] "rpm" LEAFSIM
 SG_ GovKp : 16|16@1+ (0.03125,0) [0|2047.97] "0.01%/rpm" LEAFSIM
 SG_ GovKi : 32|16@1+ (0.03125,0) [0|2047.97] "0.001%/rpm/tk" LEAFSIM
 SG_ GovKd : 48|16@1+ (0.03125,0) [0|2047.97] "%/(rpm/tick)" LEAFSIM

BO_ 1187 GOV_State_4A3: 8 ZOMBIE
 SG_ GovImax : 0|8@1+ (1,0) [0|255] "%" LEAFSIM
 SG_ GovFlt : 8|8@1+ (1,0) [0|6] "" LEAFSIM
 SG_ Opmode : 16|8@1+ (1,0) [0|255] "" LEAFSIM
