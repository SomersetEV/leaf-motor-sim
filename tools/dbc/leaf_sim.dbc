 SG_ TorqDerate : 32|8@1+ (1,0) [0|255] "" LEAFSIM
 SG_ Regenmax : 40|8@1- (1,0) [-128|127] "%" LEAFSIM
 SG_ Throtramp : 48|8@1+ (1,0) [0|255] "%/10ms" LEAFSIM

BO_ 1370 INV_Temps_55A: 8 LEAFSIM
 SG_ MotorTemp : 8|8@1+ (0.555556,-17.7778) [-17.7778|123.889] "degC" ZOMBIE
 SG_ InverterTemp : 16|8@1+ (0.555556,-17.7778) [-17.7778|123.889] "degC" ZOMBIE


CM_ BU_ ZOMBIE "ZombieVerter VCU, real hardware under test.";
CM_ BU_ LEAFSIM "LilyGo T-CAN485 simulating the Nissan Leaf inverter, motor and load.";
CM_ BO_ 282 "Leaf VCM gear and on/off, sent by the Zombie every 10 ms in run mode only.";
CM_ SG_ 282 Gear "0x4E drive, 0x2E reverse, 0x01 park.";
CM_ SG_ 282 OnOff "0x40 car on, 0x80 off (charging).";
CM_ BO_ 468 "Leaf VCM torque request, sent by the Zombie every 10 ms in run mode only.";
CM_ SG_ 468 TorqueRequestRaw "Counts. Zombie: raw = torquePercent * 2047 / 100 (LeafINV::SetTorque). Nm = raw * kT; kT 0.25 Nm is an assumption, VERIFY (plan section 12, V1). Decoded Nm is in 0x4B0 from M5.";
CM_ SG_ 468 HVStatus "7 HV on, 3 precharge, 2 off.";
CM_ SG_ 468 CRC "Nissan CRC-8, polynomial 0x85, over bytes 0-6.";
CM_ BO_ 474 "Leaf inverter status, sent by the simulator every 10 ms from power-up.";
CM_ SG_ 474 Voltage "Zombie uses it as udc only below 420 V with ShuntType = 0.";
CM_ SG_ 474 ReportedTorque "Layout is an assumption, VERIFY (plan section 12, V3). Always 0 from the simulator.";
CM_ SG_ 474 MotorSpeed "True signed speed. The Zombie decodes reverse speeds 1 rpm high.";
CM_ SG_ 474 ErrorBits "Byte 6 bits 4-7. Zombie: error when (byte6 & 0xB0) != 0. Simulator fault sets bit 4.";
CM_ BO_ 1370 "Leaf inverter temperatures, sent by the simulator every 100 ms. Degrees Fahrenheit on the bus.";
CM_ BO_ 1184 "Zombie governor log, every 10 ms in run mode with GovLog = On (branch gov-logging).";
CM_ SG_ 1184 GovSpeedIn "Absolute speed passed to SpeedLimitCommand (previous tick's speed).";
CM_ SG_ 1184 GovSpeedErr "revlim minus the governor's filtered speed.";
CM_ SG_ 1184 PotUser "Driver throttle demand before any limit.";
CM_ SG_ 1184 Potnom "Final throttle after all limits and the ramp, before direction.";
CM_ BO_ 1185 "Zombie governor terms, every 10 ms in run mode with GovLog = On. Governor output = GovP + GovD + GovInt.";
CM_ SG_ 1185 GovBinding "The governor reduced the throttle this tick.";
CM_ SG_ 1185 GovIntFrozen "Integral held: the pedal, not the governor, was the binding limit.";
CM_ SG_ 1185 GovCounter "Increments every frame; gaps mean dropped frames.";
CM_ BO_ 1186 "Zombie governor gains as entered, every 100 ms with GovLog = On.";
CM_ BO_ 1187 "Zombie governor settings and state, every 100 ms with GovLog = On.";
CM_ SG_ 1187 GovFlt "Speed filter shift: 4 is about 155 ms, 3 about 75 ms, 2 about 35 ms.";

VAL_ 282 Gear 78 "Drive" 46 "Reverse" 1 "Park" ;
VAL_ 468 HVStatus 7 "HV on" 3 "Precharge" 2 "Off" ;
VAL_ 1187 Opmode 0 "Off" 1 "Run" 2 "Precharge" 3 "PchFail" 4 "Charge" 5 "Preheat" ;
